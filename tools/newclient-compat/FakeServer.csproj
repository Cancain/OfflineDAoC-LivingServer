<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the server's build output (dotnet build source/server/Tests/Tests.csproj -c Release) -->
    <ServerLib Condition="'$(ServerLib)' == ''">$(MSBuildThisFileDirectory)../../source/server/build/Tests/Release/lib</ServerLib>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ServerLib)/*.dll" Exclude="$(ServerLib)/Tests.dll;$(ServerLib)/*Test*.dll;$(ServerLib)/NUnit*.dll;$(ServerLib)/Microsoft.Testing*.dll" />
  </ItemGroup>
</Project>
